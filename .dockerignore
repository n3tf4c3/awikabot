**/node_modules
**/dist
docs
spike
relatorios
backups
# Nada de ambiente, credencial nem chave entra no contexto do build, em pasta nenhuma: o que entra
# no contexto pode ficar no cache de um estágio, mesmo sem ir para a imagem final.
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/.npmrc
**/credentials.json
**/.credentials.json
**/auth.json
# O que a compilação local deixa para trás.
**/target
**/.expo
**/coverage
# Do app só o manifesto entra, para o lockfile fechar.
apps/mobile/*
!apps/mobile/package.json
